FROM osrf/ros:jazzy-desktop

ARG ROS_USER=ros
ARG LOCAL_UID=1000
ARG LOCAL_GID=1000

ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DISTRO=jazzy \
    RMW_IMPLEMENTATION=rmw_fastrtps_cpp \
    QT_X11_NO_MITSHM=1

# Configure Nanjing University (NJU) APT mirrors
RUN set -eux; \
    for file in /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do \
        [ -f "$file" ] || continue; \
        sed -i \
            -e 's|http://archive.ubuntu.com/ubuntu|https://mirrors.nju.edu.cn/ubuntu|g' \
            -e 's|http://security.ubuntu.com/ubuntu|https://mirrors.nju.edu.cn/ubuntu|g' \
            -e 's|http://packages.ros.org/ros2/ubuntu|https://mirrors.nju.edu.cn/ros2/ubuntu|g' \
            "$file"; \
    done

# NJU ROS 2 mirror does not provide source package indexes
RUN sed -i 's/^Types: deb deb-src$/Types: deb/' \
    /etc/apt/sources.list.d/ros2.sources

# All ROS, Gazebo, colcon, and Python dependencies stay inside this image.
# ros-jazzy-ros-gz selects the supported Gazebo Harmonic vendor packages.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-jazzy-ros-gz \
        ros-jazzy-rviz2 \
        python3-colcon-common-extensions \
        python3-rosdep \
        python3-vcstool \
        python3-pip \
        python3-venv \
        build-essential \
        bash-completion \
        git \
        xauth \
        mesa-utils \
        libgl1-mesa-dri \
        less \
        nano \
    && rm -rf /var/lib/apt/lists/*

# Match the host UID/GID to avoid root-owned bind-mounted files. Ubuntu 24.04
# images may already contain a UID-1000 "ubuntu" user: reuse that UID safely.
RUN set -eux; \
    if getent passwd "${LOCAL_UID}" >/dev/null; then \
        old_user="$(getent passwd "${LOCAL_UID}" | cut -d: -f1)"; \
        if [ "${old_user}" != "${ROS_USER}" ]; then \
            usermod -l "${ROS_USER}" "${old_user}"; \
        fi; \
        usermod -d "/home/${ROS_USER}" -m "${ROS_USER}"; \
        usermod -s /bin/bash "${ROS_USER}"; \
    else \
        if ! getent group "${LOCAL_GID}" >/dev/null; then \
            groupadd --gid "${LOCAL_GID}" "${ROS_USER}"; \
        fi; \
        useradd --uid "${LOCAL_UID}" --gid "${LOCAL_GID}" \
            --create-home --shell /bin/bash "${ROS_USER}"; \
    fi; \
    if [ "$(id -g "${ROS_USER}")" != "${LOCAL_GID}" ]; then \
        if ! getent group "${LOCAL_GID}" >/dev/null; then \
            groupadd --gid "${LOCAL_GID}" ros-host; \
        fi; \
        usermod --gid "${LOCAL_GID}" "${ROS_USER}"; \
    fi; \
    mkdir -p /workspace/ros2_ws/src; \
    chown -R "${LOCAL_UID}:${LOCAL_GID}" /workspace

USER ${ROS_USER}
WORKDIR /workspace/ros2_ws

RUN printf '\nsource /opt/ros/jazzy/setup.bash\n' >> /home/${ROS_USER}/.bashrc

CMD ["bash"]
